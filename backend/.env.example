# ============================================================
# VARIABLES DE ENTORNO — Solo a un Click
# Copiar este archivo como .env y completar los valores reales
# NUNCA subir .env a git (ya está en .gitignore)
# ============================================================

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_USER=soloaunclick
DB_PASS=tu_password_aqui
DB_NAME=soloaunclick

# --- Autenticación JWT ---
# OBLIGATORIO: mínimo 32 caracteres, usar una clave aleatoria segura
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_segura_de_minimo_32_caracteres

# --- Entorno ---
NODE_ENV=production
# DEV_MODE: JAMÁS definir esta variable en producción.
# Solo se usa en desarrollo local para habilitar herramientas de debug.
# DEV_MODE=true  ← solo en .env.development local, nunca en producción

# --- Nivel de logs ---
# Opciones: error, warn, info, debug
LOG_LEVEL=info

# --- Email (SMTP) ---
# Configurar para recuperación de contraseña
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_gmail
SMTP_FROM=noreply@soloaunclick.cl

# --- URL del sitio ---
SITE_URL=https://soloaunclick.cl
