# ============================================================
# .env.test — Entorno de Testing (branch: feature/db-schema-v2)
# ============================================================
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.test.example .env.test
#   2. Completar con las credenciales de tu MySQL (local o VPS)
#   3. Ejecutar tests: NODE_ENV=test npm test
#
# ── OPCIÓN A: VPS (ya configurado) ──────────────────────────
#   BD:     soloaunclick_test @ 45.236.131.104
#   User:   sac_test
#   Schema y seed ya cargados
#   Conectar via SSH tunnel si se corre desde local:
#     ssh -L 3307:localhost:3306 drop -N
#   Luego usar DB_HOST=127.0.0.1 DB_PORT=3307
#
# ── OPCIÓN B: Local ─────────────────────────────────────────
#   3. Crear la BD: mysql -u root -p -e "CREATE DATABASE soloaunclick_test CHARACTER SET utf8mb4;"
#   4. Cargar schema: mysql -u root -p soloaunclick_test < migrations/000_schema_base.sql
#   5. Cargar seed:   mysql -u root -p soloaunclick_test < migrations/seed_test.sql
# ============================================================

# Base de datos de TESTING (NUNCA apuntar a producción)
DB_HOST=localhost
DB_USER=sac_test
DB_PASS=SacTest2026!
DB_NAME=soloaunclick_test

# JWT — usar secret diferente al de producción
JWT_SECRET=test_jwt_secret_no_usar_en_produccion_32chars

# Servidor
PORT=3001
NODE_ENV=test

# Upload — directorio local de testing
UPLOAD_DIR=./uploads_test

# Email — usar mailtrap.io o similar para no enviar emails reales
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=tu_mailtrap_user
MAIL_PASS=tu_mailtrap_pass
MAIL_FROM=test@soloaunclick.cl

# CORS — habilitar localhost para tests
CORS_ORIGIN=http://localhost:3000
